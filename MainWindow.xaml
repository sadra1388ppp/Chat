<Window x:Class="FakeChatStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FakeChat Studio" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#F4F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#12151C"/>
        <SolidColorBrush x:Key="Panel2" Color="#171B24"/>
        <SolidColorBrush x:Key="Border" Color="#252B36"/>
        <SolidColorBrush x:Key="Muted" Color="#8993A4"/>
        <SolidColorBrush x:Key="Accent" Color="#6C63FF"/>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B9C2D0"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6C63FF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#10131A" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#6C63FF">
                        <TextBlock Text="✦" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0"><TextBlock Text="Midnight Story" FontSize="16" x:Name="ProjectNameText" FontWeight="SemiBold"/>
                        <TextBlock Text="CREATOR" FontSize="9" Foreground="#727C8E"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Editor" Style="{StaticResource GhostButton}" Foreground="White"/>
                    <Button Content="Timeline" Style="{StaticResource GhostButton}"/>
                    <Button Content="Preview" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedText" Text="Saved" Foreground="#7F8A9B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Export" Click="Export_Click" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                    <Button Content="Save Project" Click="SaveProject_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0F1218" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="18,20,18,0">
                        <TextBlock Text="PROJECT" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                        <TextBlock Text="Midnight Story" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,18"/>
                        <Button Content="+  Add Character" Height="40" Style="{StaticResource PrimaryButton}" Click="AddCharacter_Click"/>
                        <TextBlock Text="CHARACTERS" FontSize="10" Foreground="#687284" FontWeight="SemiBold" Margin="3,26,0,10"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CharactersPanel" Margin="18,0,18,20">
                        <Border Background="#191D26" CornerRadius="10" Padding="10" Margin="0,0,0,7" BorderBrush="#343A48" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#5D5FEF"><TextBlock Text="A" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Alex" FontWeight="SemiBold"/><TextBlock Text="Main character" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
                                <TextBlock Grid.Column="2" Text="●" Foreground="#55D68A" FontSize="9" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="#151820" CornerRadius="10" Padding="10" Margin="0,0,0,7">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#E56B9A"><TextBlock Text="S" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Sara" FontWeight="SemiBold"/><TextBlock Text="Friend" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#151820" CornerRadius="10" Padding="10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#E7A84B"><TextBlock Text="M" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Mike" FontWeight="SemiBold"/><TextBlock Text="Friend" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel></ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Background="#0B0D12">
                <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#10131A" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="Alex &amp; Sara" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Private conversation  •  2 participants" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                        <Button Content="⋮" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" FontSize="22"/></Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel" Margin="42,28">
                        <TextBlock Text="TODAY" HorizontalAlignment="Center" FontSize="10" Foreground="#657083" Margin="0,0,0,20"/>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,120,10"><Border Background="#1B202A" CornerRadius="16,16,16,4" Padding="15,10">
                            <TextBlock Text="Hey! Are you still working on the story?" FontSize="14"/></Border><TextBlock Text="18:30  •  Alex" FontSize="10" Foreground="#657083" Margin="5,5,0,0"/></StackPanel>
                        <StackPanel HorizontalAlignment="Right" Margin="120,0,0,10"><Border Background="#655DEB" CornerRadius="16,16,4,16" Padding="15,10">
                            <TextBlock Text="Yeah 😄 I just finished the first scene." FontSize="14"/></Border><TextBlock Text="18:31  •  Sara  ✓✓" FontSize="10" Foreground="#657083" HorizontalAlignment="Right" Margin="0,5,5,0"/></StackPanel>
                        <StackPanel HorizontalAlignment="Left" Margin="0,0,170,10"><Border Background="#1B202A" CornerRadius="16,16,16,4" Padding="15,10">
                            <TextBlock Text="Nice. Send it to me when you're ready." FontSize="14"/></Border><TextBlock Text="18:32  •  Alex" FontSize="10" Foreground="#657083" Margin="5,5,0,0"/></StackPanel>
                        <StackPanel HorizontalAlignment="Right" Margin="120,0,0,10"><Border Background="#655DEB" CornerRadius="16,16,4,16" Padding="15,10">
                            <TextBlock Text="Give me two minutes." FontSize="14"/></Border><TextBlock Text="18:33  •  Sara  ✓✓" FontSize="10" Foreground="#657083" HorizontalAlignment="Right" Margin="0,5,5,0"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#10131A" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="#191D26" CornerRadius="12" BorderBrush="#2B313D" BorderThickness="1" Padding="14,0">
                            <TextBox x:Name="MessageInput" Text="" Background="Transparent" Foreground="#7F899A" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13"/>
                        </Border>
                        <Button Grid.Column="1" Content="Send" Click="NewMessage_Click" Style="{StaticResource PrimaryButton}" Width="76" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="#0F1218" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
                    <TextBlock Text="INSPECTOR" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                    <TextBlock Text="Message" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,22"/>
                    <TextBlock Text="CONTENT" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                    <TextBox x:Name="MessageTextBox" Text="" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Background="#171B24" Foreground="#E8ECF3" BorderBrush="#2B313D" Padding="10" Margin="0,9,0,18"/>
                    <TextBlock Text="SENDER" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                    <ComboBox x:Name="SenderCombo" Height="38" Background="#171B24" Foreground="#E8ECF3" BorderBrush="#2B313D" Margin="0,9,0,18"><ComboBoxItem Content="Sara"/><ComboBoxItem Content="Alex"/><ComboBoxItem Content="Mike"/></ComboBox>
                    <TextBlock Text="TIMESTAMP" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                    <TextBox x:Name="TimeTextBox" Text="" Height="38" Background="#171B24" Foreground="#E8ECF3" BorderBrush="#2B313D" Padding="10" Margin="0,9,0,18"/>
                    <TextBlock Text="STATUS" FontSize="10" Foreground="#687284" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,10,0,18"><CheckBox Content="Delivered" IsChecked="True" Margin="0,0,0,9"/><CheckBox x:Name="ReadCheckBox" Content="Read / Seen" IsChecked="True"/></StackPanel>
                    <StackPanel><Button Content="Apply Changes" Height="38" Style="{StaticResource PrimaryButton}" Click="ApplyMessage_Click" Margin="0,0,0,10"/><Button Content="Delete Message" Height="36" Style="{StaticResource GhostButton}" Click="DeleteMessage_Click" Margin="0,0,0,14"/><Border Background="#151922" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="Message effects" FontWeight="SemiBold"/>
                        <TextBlock Text="Replies, reactions and typing indicators will be added in the timeline editor." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border></StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>