<Window x:Class="Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Deactivated="MainWindow_Deactivated"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Title="Chat"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Opacity="0.22"/>

        <Style x:Key="PopupActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PopupActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>



        <Style x:Key="ConversationContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ConversationContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>\n                        <ColumnDefinition Width="*"/>\n                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SendAsButton"
                            Click="SendAsButton_Click"
                            Style="{StaticResource IconButton}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Send as You">
                        <Ellipse x:Name="SendAsIndicator"
                                 Width="20"
                                 Height="20"
                                 Fill="#AEB4BE"/>
                    </Button>
<Border Grid.Column="1"
                            Background="{DynamicResource InputBackground}"
                            CornerRadius="20"
                            Padding="16,0"
                            Margin="0,0,8,0">
                        <TextBox x:Name="MessageInput"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="70"
                                 PreviewKeyDown="MessageInput_PreviewKeyDown"
                                 IsEnabled="False"/>
                    </Border>

                    <Button Grid.Column="2"
                            Content="➤"
                            Click="SendMessage_Click"
                            Style="{StaticResource IconButton}"
                            Width="46"
                            Height="46"
                            FontSize="19"
                            Foreground="White"
                            Background="{DynamicResource Accent}"
                            x:Name="SendButton"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsView"
              Grid.Column="1"
              Panel.ZIndex="900"
              Background="{DynamicResource WindowBackground}"
              Visibility="Collapsed">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="←  Back" Click="CloseSettings_Click"
                            Style="{StaticResource GhostButton}"
                            Foreground="{DynamicResource Accent}" Padding="4,8"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="Customize your Chat experience" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,18">
                    <StackPanel>
                        <TextBlock Text="THEME" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Choose your Chat look" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Pick a theme and it applies instantly." FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,12"/>
                                <WrapPanel x:Name="SettingsThemeButtonsPanel"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="THEME SYNC" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <Grid Height="58">
                                <StackPanel Margin="16,0,70,0" VerticalAlignment="Center">
                                    <TextBlock Text="Use theme colors" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Synchronize message bubbles with the selected theme."
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="SettingsUseThemeColorsCheckBox" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                          Click="SettingsUseThemeColorsCheckBox_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{DynamicResource MessageIncoming}" CornerRadius="16,16,16,5"
                                        Padding="12,10" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="Hey, how's it going?" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                </Border>
                                <Border Background="{DynamicResource MessageOutgoing}" CornerRadius="16,16,5,16"
                                        Padding="12,10" HorizontalAlignment="Right">
                                    <TextBlock Text="I'm doing great, thanks!" Foreground="White" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="BUBBLE COLORS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Height="54">
                                    <TextBlock Text="My Bubbles" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SettingsOutgoingColorBox" Width="104" Height="34"
                                             HorizontalAlignment="Right" Margin="0,0,12,0" Padding="9"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Their Bubbles" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SettingsIncomingColorBox" Width="104" Height="34"
                                             HorizontalAlignment="Right" Margin="0,0,12,0" Padding="9"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Height="54">
                                    <TextBlock Text="Read Receipts" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsReadReceiptsCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Timestamps" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsTimestampCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Typing Indicator" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsTypingCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ABOUT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Chat" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Conversation practice • Windows" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="2" Content="Done" Click="DoneSettings_Click"
                        Style="{StaticResource PrimaryButton}" Height="46"/>
            </Grid>
        </Grid>

        <Canvas x:Name="OverlayCanvas"
                Grid.Column="1"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                ClipToBounds="False">
            <!-- Conversation menu -->
            <Border x:Name="ConversationActionsFlyout"
                    Width="280"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="7"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <Border Background="{DynamicResource AccentSoft}"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="2,2,2,7">
                        <StackPanel>
                            <TextBlock Text="{Binding ElementName=ConversationTitleText, Path=Text}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ConversationActionsCountText"
                                       Text="No messages yet"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Click="CustomizeChatFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✦"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Customize chat"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="ExportChatFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="↗"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Export as PNG"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

               <Button Click="DeleteChatFlyout_Click"
                            Style="{StaticResource PopupDangerButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="#18D92D20"
                                    VerticalAlignment="Center">
                                <TextBlock Text="×"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Delete conversation"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Danger}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Message right-click menu -->
            <Border x:Name="MessageActionsFlyout"
                    Width="245"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="7"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock x:Name="MessageActionsHeader"
                               Text="MESSAGE"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="10,5,10,8"/>

                    <Button Click="MessageReactFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✦"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="MessageReactFlyoutLabel"
                                       Grid.Column="1"
                                       Text="React to message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="CopyMessageFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="▣"
                                           FontSize="12"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Copy message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="DeleteMessageFlyout_Click"
                            Style="{StaticResource PopupDangerButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="#18D92D20"
                                    VerticalAlignment="Center">
                                <TextBlock Text="×"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Delete message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Danger}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Reaction chooser opened only from the right-click menu -->
            <Border x:Name="ReactionActionsFlyout"
                    Width="330"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock Text="REACTION"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="10,4,10,7"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Tag="❤️" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="❤️" FontSize="22"/></Button>
                        <Button Tag="👍" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="👍" FontSize="22"/></Button>
                        <Button Tag="😂" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="😂" FontSize="22"/></Button>
                        <Button Tag="😮" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="😮" FontSize="22"/></Button>
                        <Button Tag="😢" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="😢" FontSize="22"/></Button>
                        <Button Tag="🔥" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><TextBlock Text="🔥" FontSize="22"/></Button>
                    </StackPanel>

                    <TextBlock x:Name="ReactionCurrentText"
                               Text="Choose a reaction"
                               FontSize="9.5"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,3"/>

                    <Button x:Name="RemoveReactionFlyoutButton"
                            Click="RemoveReactionFlyout_Click"
                            Style="{StaticResource PopupDangerButton}"
                            Visibility="Collapsed">
                        <TextBlock Text="Remove reaction"
                                   HorizontalAlignment="Center"
                                   FontSize="11.5"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>