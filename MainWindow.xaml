<Window x:Class="Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Deactivated="MainWindow_Deactivated"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Title="Chat"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="28"
                          ShadowDepth="8"
                          Opacity="0.22"/>

        <Style x:Key="PopupActionButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupDangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PopupActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        </Style>

        <Style x:Key="PopupReactionButton"
               TargetType="Button"
               BasedOn="{StaticResource PopupActionButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="74"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Messages"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="SidebarStatusText"
                                   Text="Your conversations"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="＋"
                            Click="NewConversation_Click"
                            Style="{StaticResource IconButton}"
                            FontSize="21"
                            Width="42"
                            Height="42"
                            Background="{DynamicResource Accent}"
                            Foreground="White"
                            ToolTip="New conversation"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="16,0,16,18"
                        Background="{DynamicResource InputBackground}"
                        CornerRadius="15"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   FontSize="19"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,2"
                                 ToolTip="Search chats and contacts"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid x:Name="ChatsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="20,0,20,10">
                            <TextBlock Text="Conversations"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="RECENT"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="ConversationList"
                                 SelectionChanged="ConversationList_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8,0"/>
                    </Grid>

                    <Grid x:Name="ContactsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="22,0,18,10">
                            <TextBlock Text="CONTACTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Add"
                                    Click="AddContact_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="11,6"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="ContactsEmptyHint"
                                   Text="Create your first contact to start a practice chat."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="22,0,22,12"
                                   Visibility="Collapsed"/>

                        <ListBox Grid.Row="2"
                                 x:Name="ContactsList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource PanelBackground}">
                    <Grid Margin="16,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChatsTabButton"
                                Content="Chats"
                                Click="ChatsTab_Click"
                                Style="{StaticResource GhostButton}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Accent}"/>

                        <Button Grid.Column="1"
                                x:Name="ContactsTabButton"
                                Content="Contacts"
                                Click="ContactsTab_Click"
                                Style="{StaticResource GhostButton}"/>

                        <Button Grid.Column="2"
                                Content="Settings"
                                Click="SidebarSettings_Click"
                                Style="{StaticResource GhostButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CurrentAvatar"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="{DynamicResource AccentSoft}"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <Grid>
                                <Ellipse x:Name="CurrentAvatarHighlight"
                                         Width="25"
                                         Height="25"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Margin="6,5,0,0"
                                         Fill="#1FFFFFFF"/>
                                <TextBlock x:Name="CurrentAvatarText"
                                           Text="?"
                                           Foreground="{DynamicResource Accent}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ConversationTitleText"
                                       Text="Chat"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ConversationSubtitleText"
                                       Text="Create a contact and your first conversation."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="CallButton"
                                Content="&#xE717;"
                                Click="Call_Click"
                                Style="{StaticResource IconButton}"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="17"
                                ToolTip="Call"/>
                                                <Button x:Name="MoreButton"
                                Content="⋯"
                                Click="More_Click"
                                Style="{StaticResource IconButton}"
                                FontSize="21"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="ExportSurface"
                        Background="{DynamicResource WindowBackground}"
                        Padding="18,24,18,30">
                    <StackPanel x:Name="MessagesPanel"
                                HorizontalAlignment="Stretch"/>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SendAsButton"
                            Click="SendAsButton_Click"
                            Style="{StaticResource IconButton}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Send as You">
                        <Ellipse x:Name="SendAsIndicator"
                                 Width="20"
                                 Height="20"
                                 Fill="#AEB4BE"/>
                    </Button>

                    <Button Grid.Column="1"
                            x:Name="EmojiButton"
                            Click="ToggleEmojiPicker_Click"
                            Style="{StaticResource IconButton}"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Emoji">
                        <emoji:TextBlock Text="😊"
                                         FontSize="21"/>
                    </Button>

                    <Border Grid.Column="2"
                            Background="{DynamicResource InputBackground}"
                            CornerRadius="20"
                            Padding="16,0"
                            Margin="0,0,8,0">
                        <TextBox x:Name="MessageInput"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="70"
                                 PreviewKeyDown="MessageInput_PreviewKeyDown"
                                 IsEnabled="False"/>
                    </Border>

                    <Button Grid.Column="3"
                            Content="➤"
                            Click="SendMessage_Click"
                            Style="{StaticResource IconButton}"
                            Width="46"
                            Height="46"
                            FontSize="19"
                            Foreground="White"
                            Background="{DynamicResource Accent}"
                            x:Name="SendButton"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SettingsView"
              Grid.Column="1"
              Panel.ZIndex="900"
              Background="{DynamicResource WindowBackground}"
              Visibility="Collapsed">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="←  Back" Click="CloseSettings_Click"
                            Style="{StaticResource GhostButton}"
                            Foreground="{DynamicResource Accent}" Padding="4,8"/>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="Customize your Chat experience" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,18">
                    <StackPanel>
                        <TextBlock Text="THEME" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Choose your Chat look" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Pick a theme and it applies instantly." FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,12"/>
                                <WrapPanel x:Name="SettingsThemeButtonsPanel"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="THEME SYNC" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <Grid Height="58">
                                <StackPanel Margin="16,0,70,0" VerticalAlignment="Center">
                                    <TextBlock Text="Use theme colors" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Synchronize message bubbles with the selected theme."
                                               FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="SettingsUseThemeColorsCheckBox" HorizontalAlignment="Right"
                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                          Click="SettingsUseThemeColorsCheckBox_Click"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="{DynamicResource MessageIncoming}" CornerRadius="16,16,16,5"
                                        Padding="12,10" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="Hey, how's it going?" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                                </Border>
                                <Border Background="{DynamicResource MessageOutgoing}" CornerRadius="16,16,5,16"
                                        Padding="12,10" HorizontalAlignment="Right">
                                    <TextBlock Text="I'm doing great, thanks!" Foreground="White" FontSize="13"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="BUBBLE COLORS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Height="54">
                                    <TextBlock Text="My Bubbles" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SettingsOutgoingColorBox" Width="104" Height="34"
                                             HorizontalAlignment="Right" Margin="0,0,12,0" Padding="9"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Their Bubbles" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SettingsIncomingColorBox" Width="104" Height="34"
                                             HorizontalAlignment="Right" Margin="0,0,12,0" Padding="9"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Height="54">
                                    <TextBlock Text="Read Receipts" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsReadReceiptsCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Timestamps" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsTimestampCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Divider}"/>
                                <Grid Height="54">
                                    <TextBlock Text="Typing Indicator" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="SettingsTypingCheckBox" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ABOUT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Chat" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Conversation practice • Windows" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="2" Content="Done" Click="DoneSettings_Click"
                        Style="{StaticResource PrimaryButton}" Height="46"/>
            </Grid>
        </Grid>

        <Canvas x:Name="OverlayCanvas"
                Grid.Column="1"
                Panel.ZIndex="1000"
                IsHitTestVisible="False"
                ClipToBounds="False">

            <!-- Emoji picker -->
            <Border x:Name="EmojiPickerFlyout"
                    Width="390"
                    Height="430"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="12"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Emoji"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="4,0,12,0"/>
                        <Border Grid.Column="1"
                                Background="{DynamicResource InputBackground}"
                                CornerRadius="12"
                                Padding="10,0">
                            <TextBox x:Name="EmojiSearchBox"
                                     Height="34"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextPrimary}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="EmojiSearchBox_TextChanged"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,12,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="EmojiButtonsPanel"
                                   HorizontalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Conversation menu -->
            <Border x:Name="ConversationActionsFlyout"
                    Width="280"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="7"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <Border Background="{DynamicResource AccentSoft}"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="2,2,2,7">
                        <StackPanel>
                            <TextBlock Text="{Binding ElementName=ConversationTitleText, Path=Text}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ConversationActionsCountText"
                                       Text="No messages yet"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Click="CustomizeChatFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✦"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Customize chat"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="ExportChatFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="↗"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Export as PNG"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

               <Button Click="DeleteChatFlyout_Click"
                            Style="{StaticResource PopupDangerButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="#18D92D20"
                                    VerticalAlignment="Center">
                                <TextBlock Text="×"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Delete conversation"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Danger}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Message right-click menu -->
            <Border x:Name="MessageActionsFlyout"
                    Width="245"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="7"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock x:Name="MessageActionsHeader"
                               Text="MESSAGE"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="10,5,10,8"/>

                    <Button Click="MessageReactFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <emoji:TextBlock Text="🙂"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="MessageReactFlyoutLabel"
                                       Grid.Column="1"
                                       Text="React to message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="CopyMessageFlyout_Click"
                            Style="{StaticResource PopupActionButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentSoft}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="▣"
                                           FontSize="12"
                                           Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Copy message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Click="DeleteMessageFlyout_Click"
                            Style="{StaticResource PopupDangerButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="#18D92D20"
                                    VerticalAlignment="Center">
                                <TextBlock Text="×"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Delete message"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource Danger}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Reaction chooser opened only from the right-click menu -->
            <Border x:Name="ReactionActionsFlyout"
                    Width="330"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8"
                    Effect="{StaticResource PopupShadow}"
                    Visibility="Collapsed"
                    IsHitTestVisible="True">
                <StackPanel>
                    <TextBlock Text="REACTION"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="10,4,10,7"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Tag="❤️" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="❤️" FontSize="22"/></Button>
                        <Button Tag="👍" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="👍" FontSize="22"/></Button>
                        <Button Tag="😂" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="😂" FontSize="22"/></Button>
                        <Button Tag="😮" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="😮" FontSize="22"/></Button>
                        <Button Tag="😢" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="😢" FontSize="22"/></Button>
                        <Button Tag="🔥" Click="ReactionChoice_Click" Style="{StaticResource PopupReactionButton}"><emoji:TextBlock Text="🔥" FontSize="22"/></Button>
                    </StackPanel>

                    <TextBlock x:Name="ReactionCurrentText"
                               Text="Choose a reaction"
                               FontSize="9.5"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,3"/>

                    <Button x:Name="RemoveReactionFlyoutButton"
                            Click="RemoveReactionFlyout_Click"
                            Style="{StaticResource PopupDangerButton}"
                            Visibility="Collapsed">
                        <TextBlock Text="Remove reaction"
                                   HorizontalAlignment="Center"
                                   FontSize="11.5"/>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>