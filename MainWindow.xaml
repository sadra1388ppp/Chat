<Window x:Class="Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="86"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chat" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SidebarStatusText"
                                   Text="Practice conversations"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="＋"
                            Click="NewConversation_Click"
                            Style="{StaticResource IconButton}"
                            FontSize="23"
                            Width="44"
                            Height="44"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="18,0,18,14"
                        Background="#F1F2F6"
                        CornerRadius="12"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   FontSize="21"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,2"
                                 ToolTip="Search chats and contacts"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid x:Name="ChatsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="CHATS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="22,0,0,10"/>

                        <ListBox Grid.Row="1"
                                 x:Name="ConversationList"
                                 SelectionChanged="ConversationList_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,0"/>
                    </Grid>

                    <Grid x:Name="ContactsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="22,0,18,10">
                            <TextBlock Text="CONTACTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Add"
                                    Click="AddContact_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="11,6"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="ContactsEmptyHint"
                                   Text="Create your first contact to start a practice chat."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="22,0,22,12"
                                   Visibility="Collapsed"/>

                        <ListBox Grid.Row="2"
                                 x:Name="ContactsList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        BorderBrush="{StaticResource Divider}"
                        BorderThickness="0,1,0,0"
                        Background="#FFFFFF">
                    <Grid Margin="16,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChatsTabButton"
                                Content="Chats"
                                Click="ChatsTab_Click"
                                Style="{StaticResource GhostButton}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource Accent}"/>

                        <Button Grid.Column="1"
                                x:Name="ContactsTabButton"
                                Content="Contacts"
                                Click="ContactsTab_Click"
                                Style="{StaticResource GhostButton}"/>

                        <Button Grid.Column="2"
                                Content="Settings"
                                Click="SidebarSettings_Click"
                                Style="{StaticResource GhostButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#F4F3F8">
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CurrentAvatar"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="#DDF5E8"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="CurrentAvatarText"
                                       Text="?"
                                       Foreground="#159447"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ConversationTitleText"
                                       Text="Chat"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ConversationSubtitleText"
                                       Text="Create a contact and your first conversation."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="AiButton"
                                Content="AI"
                                Click="AiPractice_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Padding="13,7"
                                Margin="0,0,7,0"
                                Visibility="Collapsed"/>
                        <Button x:Name="CallButton"
                                Content="☎"
                                Click="Call_Click"
                                Style="{StaticResource IconButton}"
                                IsEnabled="False"/>
                        <Button x:Name="MoreButton"
                                Content="⋯"
                                Click="More_Click"
                                Style="{StaticResource IconButton}"
                                FontSize="21"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="ExportSurface"
                        Background="#F4F3F8"
                        Padding="32,24,32,30">
                    <StackPanel x:Name="MessagesPanel"
                                MaxWidth="780"/>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Content="☺"
                            Click="Emoji_Click"
                            Style="{StaticResource IconButton}"
                            FontSize="21"
                            IsEnabled="False"
                            x:Name="EmojiButton"/>

                    <Border Grid.Column="1"
                            Background="#F1F2F6"
                            CornerRadius="18"
                            Padding="14,0"
                            Margin="6,0,8,0">
                        <TextBox x:Name="MessageInput"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="70"
                                 PreviewKeyDown="MessageInput_PreviewKeyDown"
                                 IsEnabled="False"/>
                    </Border>

                    <Button Grid.Column="2"
                            Content="➤"
                            Click="SendMessage_Click"
                            Style="{StaticResource IconButton}"
                            Width="46"
                            Height="46"
                            FontSize="19"
                            Foreground="White"
                            Background="{StaticResource Accent}"
                            x:Name="SendButton"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>