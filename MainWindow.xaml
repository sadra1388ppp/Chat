<Window x:Class="Chat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="74"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Messages"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="SidebarStatusText"
                                   Text="Your conversations"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="＋"
                            Click="NewConversation_Click"
                            Style="{StaticResource IconButton}"
                            FontSize="21"
                            Width="42"
                            Height="42"
                            Background="{DynamicResource Accent}"
                            Foreground="White"
                            ToolTip="New conversation"/>
                </Grid>

                <Border Grid.Row="1"
                        Margin="16,0,16,18"
                        Background="{DynamicResource InputBackground}"
                        CornerRadius="15"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   FontSize="19"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{DynamicResource TextPrimary}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,2"
                                 ToolTip="Search chats and contacts"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid x:Name="ChatsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="20,0,20,10">
                            <TextBlock Text="Conversations"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="RECENT"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="ConversationList"
                                 SelectionChanged="ConversationList_SelectionChanged"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8,0"/>
                    </Grid>

                    <Grid x:Name="ContactsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="22,0,18,10">
                            <TextBlock Text="CONTACTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Add"
                                    Click="AddContact_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="11,6"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="ContactsEmptyHint"
                                   Text="Create your first contact to start a practice chat."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="22,0,22,12"
                                   Visibility="Collapsed"/>

                        <ListBox Grid.Row="2"
                                 x:Name="ContactsList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10,0"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="0,1,0,0"
                        Background="{DynamicResource PanelBackground}">
                    <Grid Margin="16,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChatsTabButton"
                                Content="Chats"
                                Click="ChatsTab_Click"
                                Style="{StaticResource GhostButton}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Accent}"/>

                        <Button Grid.Column="1"
                                x:Name="ContactsTabButton"
                                Content="Contacts"
                                Click="ContactsTab_Click"
                                Style="{StaticResource GhostButton}"/>

                        <Button Grid.Column="2"
                                Content="Settings"
                                Click="SidebarSettings_Click"
                                Style="{StaticResource GhostButton}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="86"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CurrentAvatar"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                Background="{DynamicResource AccentSoft}"
                                Margin="0,0,12,0">
                            <TextBlock x:Name="CurrentAvatarText"
                                       Text="?"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ConversationTitleText"
                                       Text="Chat"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ConversationSubtitleText"
                                       Text="Create a contact and your first conversation."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="AiButton"
                                Content="AI"
                                Click="AiPractice_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="38"
                                Padding="13,7"
                                Margin="0,0,7,0"
                                Visibility="Collapsed"/>
                        <Button x:Name="CallButton"
                                Click="Call_Click"
                                Style="{StaticResource IconButton}"
                                IsEnabled="False"
                                ToolTip="Practice call">
                            <TextBlock Text="&#xE717;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"/>
                        </Button>
                        <Button x:Name="MoreButton"
                                Content="⋯"
                                Click="More_Click"
                                Style="{StaticResource IconButton}"
                                FontSize="21"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="ExportSurface"
                        Background="{DynamicResource WindowBackground}"
                        Padding="18,24,18,30">
                    <StackPanel x:Name="MessagesPanel"
                                HorizontalAlignment="Stretch"/>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SendAsButton"
                            Click="SendAsButton_Click"
                            Style="{StaticResource IconButton}"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Margin="0,0,8,0"
                            ToolTip="Send as You">
                        <Ellipse x:Name="SendAsIndicator"
                                 Width="20"
                                 Height="20"
                                 Fill="#AEB4BE"/>
                    </Button>

                    <Border Grid.Column="1"
                            Background="{DynamicResource InputBackground}"
                            CornerRadius="20"
                            Padding="16,0"
                            Margin="0,0,8,0">
                        <TextBox x:Name="MessageInput"
                                 FontSize="13"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="70"
                                 PreviewKeyDown="MessageInput_PreviewKeyDown"
                                 IsEnabled="False"/>
                    </Border>

                    <Button Grid.Column="2"
                            Content="➤"
                            Click="SendMessage_Click"
                            Style="{StaticResource IconButton}"
                            Width="46"
                            Height="46"
                            FontSize="19"
                            Foreground="White"
                            Background="{DynamicResource Accent}"
                            x:Name="SendButton"
                            IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>