<Window x:Class="FakeChatStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FakeChat Studio"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        Foreground="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#151820" BorderBrush="#242936" BorderThickness="0,0,1,0">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FakeChat" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="STUDIO" FontSize="11" Foreground="#7E8A9E" Margin="2,0,0,26"/>
                    <Button Content="+  New Project" Height="42" Margin="0,0,0,18"
                            Background="#5B5FEF" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Click="NewProject_Click"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="WORKSPACE" FontSize="11" Foreground="#6F7889" Margin="4,12,0,10"/>
                    <Button Content="⌂   Projects" Height="38" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#DCE2EC" BorderThickness="0"/>
                    <Button Content="▣   Templates" Height="38" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#DCE2EC" BorderThickness="0"/>
                    <Button Content="⚙   Settings" Height="38" HorizontalContentAlignment="Left"
                            Background="Transparent" Foreground="#DCE2EC" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Create your chat story" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="Design conversations, characters and timelines in one place."
                           FontSize="15" Foreground="#8D97A8" Margin="0,8,0,28"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#151820" CornerRadius="16" Padding="28" Margin="0,0,22,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="New project" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Start with an empty conversation and build your scene."
                                   Foreground="#8D97A8" Margin="0,8,0,22"/>
                        <Button Content="Create Project" Width="170" Height="44" HorizontalAlignment="Left"
                                Background="#5B5FEF" Foreground="White" BorderThickness="0"
                                FontWeight="SemiBold" Click="NewProject_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#151820" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Roadmap" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="01  Project &amp; chat editor" Margin="0,18,0,8"/>
                        <TextBlock Text="02  Characters &amp; messages" Foreground="#8D97A8" Margin="0,0,0,8"/>
                        <TextBlock Text="03  Timeline &amp; animation" Foreground="#8D97A8" Margin="0,0,0,8"/>
                        <TextBlock Text="04  Preview &amp; export" Foreground="#8D97A8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
