<Window x:Class="Chat.Dialogs.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Call"
        Width="520"
        Height="760"
        MinWidth="500"
        MinHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CallBackground}"
        Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CallControlButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Background" Value="{DynamicResource CallPanel}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#29323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="32">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#24303B"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EndCallButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="38">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot"
                         Width="8"
                         Height="8"
                         Fill="{DynamicResource Accent}"
                         Margin="0,0,9,0"/>
                <StackPanel>
                    <TextBlock Text="Voice call"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="CallModeText"
                               Text="Calling"
                               FontSize="10"
                               Foreground="{DynamicResource CallSecondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Click="Close_Click"
                    Style="{StaticResource IconButton}"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    ToolTip="Close">
                <TextBlock Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="18,22,18,22">

            <Grid Width="190"
                  Height="190"
                  HorizontalAlignment="Center">
                <Ellipse x:Name="OuterRing"
                         Width="190"
                         Height="190"
                         Stroke="{DynamicResource Accent}"
                         StrokeThickness="1"
                         Opacity="0.14"/>
                <Ellipse x:Name="InnerRing"
                         Width="166"
                         Height="166"
                         Fill="{DynamicResource CallPanel}"
                         Stroke="#29323C"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Border x:Name="AvatarCircle"
                        Width="126"
                        Height="126"
                        CornerRadius="63"
                        Background="{DynamicResource Accent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarText"
                               Text="?"
                               FontSize="42"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="NameText"
                       Text="Contact"
                       FontSize="29"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>

            <TextBlock x:Name="PhoneText"
                       Text=""
                       FontSize="11"
                       Foreground="{DynamicResource CallSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

            <TextBlock x:Name="StatusText"
                       Text="Calling…"
                       FontSize="13"
                       Foreground="{DynamicResource CallSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>

            <TextBlock x:Name="TimerText"
                       Text="00:00"
                       FontSize="31"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>

            <Border Background="#151B21"
                    BorderBrush="#25303A"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="14,9"
                    Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{DynamicResource Accent}"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnectionText"
                               Text="Connecting securely…"
                               FontSize="10.5"
                               Foreground="{DynamicResource CallSecondary}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2"
                Background="#151B21"
                BorderBrush="#25303A"
                BorderThickness="1"
                CornerRadius="26"
                Padding="18,18,18,16">
            <StackPanel>
                <TextBlock Text="CALL CONTROLS"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CallSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Width="74">
                        <Button x:Name="MuteButton"
                                Click="Mute_Click"
                                Style="{StaticResource CallControlButton}"
                                IsEnabled="False"
                                HorizontalAlignment="Center"
                                ToolTip="Mute">
                            <TextBlock x:Name="MuteIcon"
                                       Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"/>
                        </Button>
                        <TextBlock x:Name="MuteLabel"
                                   Text="Mute"
                                   FontSize="9"
                                   Foreground="{DynamicResource CallSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Width="74"
                                Margin="18,0">
                        <Button x:Name="SpeakerButton"
                                Click="Speaker_Click"
                                Style="{StaticResource CallControlButton}"
                                IsEnabled="False"
                                HorizontalAlignment="Center"
                                ToolTip="Speaker">
                            <TextBlock x:Name="SpeakerIcon"
                                       Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"/>
                        </Button>
                        <TextBlock Text="Speaker"
                                   FontSize="9"
                                   Foreground="{DynamicResource CallSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel Width="86">
                        <Button x:Name="EndButton"
                                Click="End_Click"
                                Style="{StaticResource EndCallButton}"
                                HorizontalAlignment="Center"
                                ToolTip="End call">
                            <TextBlock Text="&#xE778;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="White"/>
                        </Button>
                        <TextBlock Text="End"
                                   FontSize="9"
                                   Foreground="{DynamicResource CallSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="AgainPanel"
                                Width="74"
                                Margin="18,0,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="CallAgainButton"
                                Click="CallAgain_Click"
                                Style="{StaticResource CallControlButton}"
                                HorizontalAlignment="Center"
                                ToolTip="Call again">
                            <TextBlock Text="&#xE717;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"/>
                        </Button>
                        <TextBlock Text="Call again"
                                   FontSize="9"
                                   Foreground="{DynamicResource CallSecondary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>