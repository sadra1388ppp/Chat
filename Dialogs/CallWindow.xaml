<Window x:Class="Chat.Dialogs.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Call"
        Width="520"
        Height="700"
        MinWidth="480"
        MinHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CallBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CallActionButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="{DynamicResource CallPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="18"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Practice Call"
                       FontSize="12"
                       Foreground="{DynamicResource CallSecondary}"/>
            <Button Click="Close_Click"
                    Style="{StaticResource IconButton}"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    ToolTip="Close">
                <TextBlock Text="&#xE8BB;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center">
            <Grid Width="190"
                  Height="190"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,18">
                <Ellipse x:Name="OuterRing"
                         Width="190"
                         Height="190"
                         Stroke="{DynamicResource Accent}"
                         StrokeThickness="1"
                         Opacity="0.15"/>
                <Ellipse Width="152"
                         Height="152"
                         Fill="{DynamicResource AccentSoft}"
                         Opacity="0.32"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Border x:Name="AvatarCircle"
                        Width="112"
                        Height="112"
                        CornerRadius="56"
                        Background="{DynamicResource Accent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarText"
                               Text="?"
                               FontSize="40"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="NameText"
                       Text="Contact"
                       FontSize="27"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText"
                       Text="Ready to call"
                       FontSize="12"
                       Foreground="{DynamicResource CallSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="TimerText"
                       Text="00:00"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"/>

            <Border Background="{DynamicResource CallPanel}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Text="CALL SCENARIO"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CallSecondary}"/>
                    <ComboBox x:Name="ScenarioCombo"
                              Height="40"
                              Margin="0,8,0,0">
                        <ComboBoxItem Content="Casual conversation"/>
                        <ComboBoxItem Content="Job interview"/>
                        <ComboBoxItem Content="Customer support"/>
                        <ComboBoxItem Content="Unexpected call"/>
                        <ComboBoxItem Content="Difficult conversation"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ConnectionText"
                       Text="Ready when you are."
                       FontSize="11"
                       Foreground="{DynamicResource CallSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>

            <TextBlock x:Name="RecapText"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="24,14,24,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="MuteButton"
                        Click="Mute_Click"
                        Style="{StaticResource CallActionButton}"
                        ToolTip="Toggle mute"/>
                <Button x:Name="SpeakerButton"
                        Click="Speaker_Click"
                        Style="{StaticResource CallActionButton}"
                        Margin="12,0"
                        ToolTip="Toggle speaker"/>
                <Button x:Name="StartButton"
                        Click="Start_Click"
                        Style="{StaticResource PrimaryButton}"
                        Width="62"
                        Height="62"
                        FontSize="23"
                        ToolTip="Start practice call"/>
                <Button x:Name="EndButton"
                        Click="End_Click"
                        Width="62"
                        Height="62"
                        FontSize="19"
                        Background="{DynamicResource Danger}"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="12,10"
                        Visibility="Collapsed"
                        Margin="12,0"
                        ToolTip="End call"/>
            <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                <TextBlock x:Name="MuteIcon"
                           Text="&#xE720;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{DynamicResource TextPrimary}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>