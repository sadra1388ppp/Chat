<Window x:Class="Chat.Dialogs.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Practice Call"
        Width="560"
        Height="780"
        MinWidth="520"
        MinHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CallBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="CallControlButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Background" Value="{DynamicResource CallPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CallCircleButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="34">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,26,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="{DynamicResource CallPanel}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1">
                    <TextBlock Text="&#xE717;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource CallSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Margin="11,0,0,0">
                    <TextBlock Text="Phone"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Practice call"
                               FontSize="10"
                               Foreground="{DynamicResource CallSecondary}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <Button Click="Close_Click"
                    Style="{StaticResource IconButton}"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    ToolTip="Close">
                <TextBlock Text="&#xE711;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="20,22">
                <Border HorizontalAlignment="Center"
                        Background="#1B222A"
                        CornerRadius="14"
                        Padding="12,6">
                    <TextBlock Text="PRIVATE PRACTICE SESSION"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CallSecondary}"
                               HorizontalAlignment="Center"/>
                </Border>

                <Grid Width="190"
                      Height="190"
                      HorizontalAlignment="Center"
                      Margin="0,18,0,18">
                    <Ellipse x:Name="OuterRing"
                             Width="190"
                             Height="190"
                             Stroke="{DynamicResource Accent}"
                             StrokeThickness="1"
                             Opacity="0.16"/>
                    <Ellipse Width="164"
                             Height="164"
                             Fill="{DynamicResource CallPanel}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Ellipse Width="146"
                             Height="146"
                             Fill="{DynamicResource AccentSoft}"
                             Opacity="0.34"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Border x:Name="AvatarCircle"
                            Width="116"
                            Height="116"
                            CornerRadius="58"
                            Background="{DynamicResource Accent}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AvatarText"
                                   Text="?"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="NameText"
                           Text="Contact"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="PhoneText"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource CallSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready to call"
                           FontSize="13"
                           Foreground="{DynamicResource CallSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>

                <TextBlock x:Name="TimerText"
                           Text="00:00"
                           FontSize="32"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>

                <StackPanel x:Name="WaveformPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Height="34"
                            Margin="0,10,0,12"
                            Opacity="0.9">
                    <Rectangle x:Name="Wave1" Width="4" Height="8" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave2" Width="4" Height="13" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave3" Width="4" Height="20" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave4" Width="4" Height="26" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave5" Width="4" Height="30" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave6" Width="4" Height="24" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave7" Width="4" Height="18" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave8" Width="4" Height="12" Fill="{DynamicResource Accent}" Margin="3,0"/>
                    <Rectangle x:Name="Wave9" Width="4" Height="8" Fill="{DynamicResource Accent}" Margin="3,0"/>
                </StackPanel>

                <Border x:Name="ScenarioPanel"
                        Background="{DynamicResource CallPanel}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="16"
                        Width="410">
                    <StackPanel>
                        <TextBlock Text="PRACTICE SCENARIO"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource CallSecondary}"/>
                        <ComboBox x:Name="ScenarioCombo"
                                  Height="40"
                                  Margin="0,8,0,0">
                            <ComboBoxItem Content="Casual conversation"/>
                            <ComboBoxItem Content="Job interview"/>
                            <ComboBoxItem Content="Customer support"/>
                            <ComboBoxItem Content="Unexpected call"/>
                            <ComboBoxItem Content="Difficult conversation"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border x:Name="ConnectionPill"
                        Background="#1B222A"
                        CornerRadius="13"
                        Padding="12,7"
                        Margin="0,14,0,0">
                    <TextBlock x:Name="ConnectionText"
                               Text="Choose a scenario, then start the practice call."
                               FontSize="10.5"
                               Foreground="{DynamicResource CallSecondary}"
                               HorizontalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="RecapText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Width="420"
                           FontSize="11"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="20,16,20,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource CallPanel}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                CornerRadius="26"
                Padding="14"
                Margin="10,16,10,0">
            <StackPanel>
                <TextBlock x:Name="CallModeText"
                           Text="Ready to start"
                           FontSize="10"
                           Foreground="{DynamicResource CallSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,11"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="MuteButton"
                            Click="Mute_Click"
                            Style="{StaticResource CallControlButton}"
                            IsEnabled="False"
                            ToolTip="Mute">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Mute"
                                       FontSize="9"
                                       Foreground="{DynamicResource CallSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SpeakerButton"
                            Click="Speaker_Click"
                            Style="{StaticResource CallControlButton}"
                            Margin="10,0"
                            IsEnabled="False"
                            ToolTip="Speaker">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE767;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="19"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Speaker"
                                       FontSize="9"
                                       Foreground="{DynamicResource CallSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="StartButton"
                            Click="Start_Click"
                            Style="{StaticResource CallCircleButton}"
                            Margin="12,0"
                            ToolTip="Start practice call">
                        <TextBlock Text="&#xE717;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="23"
                                   Foreground="White"/>
                    </Button>

                    <Button x:Name="EndButton"
                            Click="End_Click"
                            Style="{StaticResource CallCircleButton}"
                            Background="{DynamicResource Danger}"
                            Visibility="Collapsed"
                            Margin="12,0"
                            ToolTip="End call">
                        <TextBlock Text="&#xE778;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="21"
                                   Foreground="White"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>