<Window x:Class="Chat.Dialogs.CreateConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Conversation"
        Width="620"
        Height="720"
        MinWidth="620"
        MinHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Start something new"
                       FontSize="25"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Choose whether you want a one-to-one practice chat or a group conversation."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ChatModeButton"
                    Click="ChatMode_Click"
                    Height="82"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Chat"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="One contact"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="GroupModeButton"
                    Grid.Column="2"
                    Click="GroupMode_Click"
                    Height="82"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Group"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Two or more contacts"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CONVERSATION TITLE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}"/>

            <TextBox x:Name="TitleBox"
                     Grid.Row="1"
                     Height="42"
                     Margin="0,7,0,14"
                     FontSize="14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ParticipantHeaderText"
                           Text="CONTACT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ParticipantModeHint"
                           Grid.Column="1"
                           Text="Select one"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <ListBox x:Name="ContactsList"
                     Grid.Row="3"
                     Margin="0,8,0,10"
                     MinHeight="180"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Multiple"
                     FontSize="13"/>

            <Border Grid.Row="4"
                    Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="10"
                    Margin="0,0,0,12">
                <TextBlock x:Name="SelectionSummaryText"
                           Text="Select a contact"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="72"/>
                </Grid.RowDefinitions>

                <TextBlock Text="SCENARIO"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"/>

                <TextBox x:Name="ScenarioBox"
                         Grid.Row="1"
                         Margin="0,7,0,0"
                         Padding="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="HintText"
                   Text="Select a contact to continue."
                   FontSize="10"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,10,0,12"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"/>
            <Button Grid.Column="1"
                    x:Name="CreateButton"
                    Content="Create Chat"
                    Click="Create_Click"
                    Style="{StaticResource PrimaryButton}"
                    Width="155"/>
        </Grid>
    </Grid>
</Window>