<Window x:Class="Chat.Dialogs.CreateConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Conversation"
        Width="620"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Start something new"
                       FontSize="25"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Choose whether you want a one-to-one practice chat or a group conversation."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ChatModeButton"
                    Click="ChatMode_Click"
                    Height="82"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Chat"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="One contact"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Button>

            <Button x:Name="GroupModeButton"
                    Grid.Column="2"
                    Click="GroupMode_Click"
                    Height="82"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Group"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Two or more contacts"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CONVERSATION TITLE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}"/>
            <TextBox x:Name="TitleBox"
                     Grid.Row="1"
                     Height="42"
                     Margin="0,7,0,16"
                     FontSize="14"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock x:Name="ParticipantHeaderText"
                               Text="CONTACT"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ParticipantModeHint"
                               Text="Select one"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="ContactsList"
                         Grid.Row="2"
                         Margin="0,8,0,14"
                         Height="215"
                         SelectionMode="Multiple"
                         FontSize="13"/>

                <Border Grid.Row="2"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource AccentSoft}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10"
                        Margin="0,0,0,14"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="SelectionSummaryText"
                               Text="Select a contact"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </Grid>

            <CheckBox x:Name="AiCheckBox"
                      Grid.Row="3"
                      Content="Enable AI conversation mode"
                      FontSize="13"
                      Margin="0,0,0,14"/>

            <StackPanel Grid.Row="4">
                <TextBlock Text="SCENARIO"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="ScenarioBox"
                         Height="72"
                         Margin="0,7,0,0"
                         Padding="11"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="HintText"
                   Text="Select a contact to continue."
                   FontSize="10"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,13,0,14"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"/>
            <Button Grid.Column="1"
                    x:Name="CreateButton"
                    Content="Create Chat"
                    Click="Create_Click"
                    Style="{StaticResource PrimaryButton}"
                    Width="155"/>
        </Grid>
    </Grid>
</Window>