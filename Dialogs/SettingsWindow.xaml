<Window x:Class="Chat.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560"
        Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F4FA"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource GhostButton}"
                    Foreground="#2B8A57"
                    HorizontalAlignment="Left"/>
            <TextBlock Text="Settings"
                       FontSize="19"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,0,16">
            <StackPanel>
                <TextBlock Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A8A96"
                           Margin="0,0,0,7"/>

                <Border Background="#FFFFFF"
                        CornerRadius="14"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <Border Background="#EBEBEF"
                                CornerRadius="15"
                                Padding="12"
                                HorizontalAlignment="Left"
                                MaxWidth="330"
                                Margin="0,0,0,9">
                            <TextBlock Text="Hey, how's it going?"
                                       Foreground="#17171A"
                                       FontSize="13"/>
                        </Border>
                        <Border Background="#0A84FF"
                                CornerRadius="15"
                                Padding="12"
                                HorizontalAlignment="Right"
                                MaxWidth="330">
                            <TextBlock Text="I'm doing great, thanks!"
                                       Foreground="White"
                                       FontSize="13"/>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="DEFAULT BUBBLE COLORS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A8A96"
                           Margin="0,0,0,7"/>

                <Border Background="#FFFFFF"
                        CornerRadius="13"
                        Padding="0"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Height="54">
                            <TextBlock Text="My Bubbles"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="OutgoingColorBox"
                                     Width="95"
                                     Height="34"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,12,0"
                                     Padding="9"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#ECECF0"/>
                        <Grid Height="54">
                            <TextBlock Text="Their Bubbles"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="IncomingColorBox"
                                     Width="95"
                                     Height="34"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,12,0"
                                     Padding="9"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="APPEARANCE"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A8A96"
                           Margin="0,0,0,7"/>

                <Border Background="#FFFFFF"
                        CornerRadius="13"
                        Padding="0"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Height="54">
                            <TextBlock Text="Read Receipts"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="ReadReceiptsCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#ECECF0"/>
                        <Grid Height="54">
                            <TextBlock Text="Timestamps"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="TimestampCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="#ECECF0"/>
                        <Grid Height="54">
                            <TextBlock Text="Typing Indicator"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="TypingCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="ABOUT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#8A8A96"
                           Margin="0,0,0,7"/>

                <Border Background="#FFFFFF"
                        CornerRadius="13"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Chat"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Conversation practice • Windows"
                                   FontSize="11"
                                   Foreground="#8A8A96"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Done"
                Click="Apply_Click"
                Style="{StaticResource PrimaryButton}"
                Height="44"/>
    </Grid>
</Window>