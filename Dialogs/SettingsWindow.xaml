<Window x:Class="Chat.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversation Settings"
        Width="520"
        Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Conversation settings" FontSize="24" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="Tune the practice chat without touching its messages." FontSize="13" Foreground="#667085" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,20">
            <CheckBox x:Name="TimestampCheckBox" Content="Show timestamps" FontSize="13" Margin="0,0,0,12"/>
            <CheckBox x:Name="TypingCheckBox" Content="Show typing indicators" FontSize="13" Margin="0,0,0,12"/>
            <CheckBox x:Name="ReadReceiptsCheckBox" Content="Show read receipts" FontSize="13" Margin="0,0,0,22"/>

            <TextBlock Text="OUTGOING BUBBLE COLOR" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="OutgoingColorBox" Height="40" Margin="0,7,0,16" Padding="11"/>

            <TextBlock Text="CONTACT BUBBLE COLOR" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="IncomingColorBox" Height="40" Margin="0,7,0,16" Padding="11"/>

            <Border Background="#F7F8FA" BorderBrush="#E3E7EC" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock Text="Both-side practice" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="Switch Send as in the composer to change the side you are practicing." TextWrapping="Wrap" FontSize="12" Foreground="#667085" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="110"/>
            <Button Grid.Column="1" Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}" Width="110"/>
        </Grid>
    </Grid>
</Window>