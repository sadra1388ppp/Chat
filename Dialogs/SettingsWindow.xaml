<Window x:Class="Chat.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="600"
        Height="780"
        MinWidth="560"
        MinHeight="700"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource GhostButton}"
                    Foreground="{DynamicResource Accent}"
                    HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1"
                       Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,0,18">
            <StackPanel>
                <TextBlock Text="THEME"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Choose your Chat look"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Changes are applied instantly and saved to this project."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,12"/>

                        <WrapPanel x:Name="ThemeButtonsPanel"
                                   Orientation="Horizontal">
                            <Button Tag="light" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#DDE3EA" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#F4F6F8" CornerRadius="6" BorderBrush="#E3E7EC" BorderThickness="1"/>
                                        <Border Width="18" Height="40" Background="#0A84FF" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Light" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#111827"/>
                                </Grid>
                            </Button>

                            <Button Tag="dark" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#171A21" BorderBrush="#2A303A" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#0F1115" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#4DA3FF" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Dark" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F5F7FA"/>
                                </Grid>
                            </Button>

                            <Button Tag="midnight" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#12182A" BorderBrush="#28324D" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#0B1020" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#7C9CFF" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Midnight" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F3F6FF"/>
                                </Grid>
                            </Button>

                            <Button Tag="ocean" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#B8E4EA" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#EEF7FA" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#00A6C7" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Ocean" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#102A33"/>
                                </Grid>
                            </Button>

                            <Button Tag="lavender" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#DCD0F5" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#F7F4FB" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#7C5CFC" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Lavender" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2A2234"/>
                                </Grid>
                            </Button>

                            <Button Tag="mint" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#BFE5D1" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#F1F8F4" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#2BAA78" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Mint" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#163026"/>
                                </Grid>
                            </Button>


                            <Button Tag="sunset" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#F26A3D" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#FBE9DE" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#F26A3D" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Sunset" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#342117"/>
                                </Grid>
                            </Button>

                            <Button Tag="graphite" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#1D2024" BorderBrush="#8C9AA8" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#272B30" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#8C9AA8" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Graphite" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#F1F3F5"/>
                                </Grid>
                            </Button>

                            <Button Tag="arctic" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#2D8FD5" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#E5F0F9" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#2D8FD5" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Arctic" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#172B3A"/>
                                </Grid>
                            </Button>

                            <Button Tag="plum" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,10"
                                    Background="#FFFFFF" BorderBrush="#A05AE8" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#F0E5F2" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#A05AE8" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Plum" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#332037"/>
                                </Grid>
                            </Button>

                            <Button Tag="rose" Click="ThemeButton_Click"
                                    Width="164" Height="76" Margin="0,0,10,0"
                                    Background="#FFFFFF" BorderBrush="#F0C7D5" BorderThickness="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="18" Height="40" Background="#FCF4F7" CornerRadius="6"/>
                                        <Border Width="18" Height="40" Background="#E45D83" CornerRadius="6" Margin="-2,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Rose" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#341E26"/>
                                </Grid>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="THEME SYNC"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,0,0,20">
                    <Grid Height="58">
                        <StackPanel Margin="16,0,70,0" VerticalAlignment="Center">
                            <TextBlock Text="Use theme colors"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Keep message bubbles synchronized with the selected app theme."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="UseThemeColorsCheckBox"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,16,0"
                                  Click="UseThemeColorsCheckBox_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="PREVIEW"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,0,20">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="{DynamicResource MessageIncoming}"
                                    CornerRadius="16,16,16,5"
                                    Padding="12,10"
                                    HorizontalAlignment="Left"
                                    MaxWidth="350"
                                    Margin="0,0,0,10">
                                <TextBlock Text="Hey, how's it going?"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="13"/>
                            </Border>
                            <Border Background="{DynamicResource MessageOutgoing}"
                                    CornerRadius="16,16,5,16"
                                    Padding="12,10"
                                    HorizontalAlignment="Right"
                                    MaxWidth="350">
                                <TextBlock Text="I'm doing great, thanks!"
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="BUBBLE COLORS"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Height="54">
                            <TextBlock Text="My Bubbles"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="OutgoingColorBox"
                                     Width="100"
                                     Height="34"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,12,0"
                                     Padding="9"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Divider}"/>
                        <Grid Height="54">
                            <TextBlock Text="Their Bubbles"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="IncomingColorBox"
                                     Width="100"
                                     Height="34"
                                     HorizontalAlignment="Right"
                                     Margin="0,0,12,0"
                                     Padding="9"
                                     VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="APPEARANCE"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <Grid Height="54">
                            <TextBlock Text="Read Receipts"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="ReadReceiptsCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Divider}"/>
                        <Grid Height="54">
                            <TextBlock Text="Timestamps"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="TimestampCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Divider}"/>
                        <Grid Height="54">
                            <TextBlock Text="Typing Indicator"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"/>
                            <CheckBox x:Name="TypingCheckBox"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="ABOUT"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8"/>

                <Border Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Chat"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Conversation practice • Windows"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Done"
                Click="Apply_Click"
                Style="{StaticResource PrimaryButton}"
                Height="46"/>
    </Grid>
</Window>
