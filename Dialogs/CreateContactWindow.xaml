<Window x:Class="Chat.Dialogs.CreateContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Contact"
        Width="520"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Create a contact" FontSize="24" FontWeight="SemiBold" Foreground="#111827"/>
            <TextBlock Text="Build a reusable persona for your practice chats." FontSize="13" Foreground="#667085" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,20">
            <TextBlock Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="NameBox" Height="40" Margin="0,7,0,16" Padding="11" FontSize="14"/>
            <TextBlock Text="ROLE" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="RoleBox" Height="40" Margin="0,7,0,16" Padding="11" FontSize="14" Text="Friend"/>
            <TextBlock Text="SCENARIO / CONTEXT" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="ContextBox" Height="90" Margin="0,7,0,16" Padding="11" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True"/>
            <CheckBox x:Name="AiCheckBox" Content="Enable AI replies for this persona" FontSize="13" Margin="0,0,0,18"/>
            <TextBlock Text="AVATAR COLOR" FontSize="11" FontWeight="SemiBold" Foreground="#667085"/>
            <TextBox x:Name="ColorBox" Height="40" Margin="0,7,0,0" Padding="11" FontSize="14" Text="#0A84FF"/>
            <TextBlock Text="Use a hex color such as #0A84FF." FontSize="11" Foreground="#98A2B3" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Width="110"/>
            <Button Grid.Column="1" Content="Create Contact" Click="Create_Click" Style="{StaticResource PrimaryButton}" Width="140"/>
        </Grid>
    </Grid>
</Window>