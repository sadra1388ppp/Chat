<Window x:Class="Chat.Dialogs.CreateContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Contact"
        Width="560"
        Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource GhostButton}"
                    Foreground="{DynamicResource Accent}"
                    HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1"
                       Text="New Contact"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,22,0,18">
            <StackPanel>
                <TextBlock Text="NAME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="NameBox" Height="42" Margin="0,6,0,16" Padding="12" FontSize="14"/>

                <TextBlock Text="SUBTITLE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="RoleBox" Height="42" Margin="0,6,0,16" Padding="12" FontSize="14" Text="Friend"/>

                <TextBlock Text="PHONE NUMBER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="PhoneBox" Height="42" Margin="0,6,0,16" Padding="12" FontSize="14"/>

                <TextBlock Text="AVATAR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,6,0,16">
                    <WrapPanel x:Name="AvatarChoices"/>
                </Border>

                <TextBlock Text="CONTEXT / NOTES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="ContextBox"
                         Height="120"
                         Margin="0,6,0,16"
                         Padding="12"
                         FontSize="13"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="BUBBLE COLOR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                <TextBox x:Name="ColorBox"
                         Height="42"
                         Margin="0,6,0,5"
                         Padding="12"
                         FontSize="14"
                         Text="#E9EDF2"/>
                <TextBlock Text="Use a hex color such as #E9EDF2."
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Create Contact"
                Click="Create_Click"
                Style="{StaticResource PrimaryButton}"
                Height="44"/>
    </Grid>
</Window>